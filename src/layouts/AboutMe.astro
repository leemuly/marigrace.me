---
import { Image } from 'astro:assets';

const { heroImage, classes } = Astro.props;
---

<html lang="en">
	<head>
		<style>
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<article class=`bg-white/75 flex flex-col items-center md:flex-row mb-4 ${classes}`>
		{heroImage && 
			<Image class="h-[250px] w-[400px] object-cover" src={heroImage} alt="" />
		}
		<div class="p-6 text-center">
			<slot />
		</div>
	</article>
</html>
