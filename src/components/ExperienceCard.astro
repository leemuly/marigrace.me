---
const { company, location, classes } = Astro.props;
---
<div class=`flex flex-col bg-white/75 ${classes} px-4 md:px-16`>
    <div class="job-header">
        <h3 class="m-0 text-3xl">
            {company}
        </h3>
        <p>
            {location}
        </p>
    </div>
    <div class="px-2 md:text-sm">
        <slot />
    </div>
</div>
